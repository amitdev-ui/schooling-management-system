{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "client/",
      "framework": "vite",
      "buildCommand": "npm install && npm run build",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "server/",
      "framework": "express",
      "entrypoint": "src/server.js"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
